# Template for the real .env file

# --- Postgres DW ---
POSTGRES_DW_USER=dw_admin
POSTGRES_DW_PASSWORD=<set your password>
POSTGRES_DW_DB=real_estate_dw
POSTGRES_DW_DSN=postgresql://dw_admin:<password>@postgres-dw:5432/real_estate_dw
POSTGRES_DW_DSN_LOCAL=postgresql://dw_admin:<password>@localhost:5433/real_estate_dw

# --- Airflow ---
AIRFLOW_UID=50000
FERNET_KEY=<run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AIRFLOW__API_AUTH__JWT_SECRET=<set your own>
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# --- AWS S3 (Bronze layer) ---
AWS_ACCESS_KEY_ID=<create a dedicated IAM user>
AWS_SECRET_ACCESS_KEY=<create a dedicated IAM user>
AWS_REGION=us-east-1
S3_BRONZE_BUCKET=<your bucket name>

# --- Spark ---
SPARK_DRIVER_MEMORY=2g
SPARK_MASTER=local[4]

# --- Dataset Base URL ---
DATASET_CDN_BASE_URL=<base url dataset>

# --- Install dependencies for the Airflow container (for quick testing) ---
_PIP_ADDITIONAL_REQUIREMENTS=

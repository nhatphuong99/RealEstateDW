# Template cho .env thật

# --- Postgres DW ---
POSTGRES_DW_USER=dw_admin
POSTGRES_DW_PASSWORD=<tự đặt mật khẩu>
POSTGRES_DW_DB=real_estate_dw
POSTGRES_DW_DSN=postgresql://dw_admin:<mat_khau>@postgres-dw:5432/real_estate_dw
POSTGRES_DW_DSN_LOCAL=postgresql://dw_admin:<mat_khau>@localhost:5433/real_estate_dw

# --- Airflow ---
AIRFLOW_UID=50000
FERNET_KEY=<chạy: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AIRFLOW__API_AUTH__JWT_SECRET=<tự đặt chuỗi random dài>
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# --- AWS S3 (Bronze layer) — CHỈ CẦN nếu muốn chạy crawler thật ---
AWS_ACCESS_KEY_ID=<tự tạo IAM user riêng>
AWS_SECRET_ACCESS_KEY=<tự tạo IAM user riêng>
AWS_REGION=us-east-1
S3_BRONZE_BUCKET=<tên bucket của bạn>

# --- Spark ---
SPARK_DRIVER_MEMORY=2g
SPARK_MASTER=local[4]

# --- Dataset Base url ---
DATASET_CDN_BASE_URL=<base url dataset>

# --- Cài dependency cho container Airflow (CHỈ dùng để chạy thử nhanh) ---
_PIP_ADDITIONAL_REQUIREMENTS=


